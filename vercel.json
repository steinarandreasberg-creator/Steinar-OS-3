{
  "cleanUrls": true,
  "functions": {
    "api/hevy.js": { "memory": 128, "maxDuration": 10 },
    "api/suggest.js": { "memory": 128, "maxDuration": 5 },
    "api/ai-feedback.js": { "memory": 128, "maxDuration": 15 },
    "api/ai-chat.js": { "memory": 128, "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
